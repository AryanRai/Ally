{
  "name": "glass-pip-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --no-sandbox",
    "build": "npm run build:vite && npm run build:electron && npm run dist",
    "build:vite": "vite build",
    "build:electron": "node scripts/build-electron.js",
    "dist": "electron-builder --config electron-builder.json",
    "build:mac": "npm run build:vite && npm run build:electron && electron-builder --mac --config electron-builder.json",
    "build:win": "npm run build:vite && npm run build:electron && electron-builder --win --config electron-builder.json",
    "build:linux": "npm run build:vite && npm run build:electron && electron-builder --linux --config electron-builder.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@google-cloud/speech": "^8.2.0",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "acorn": "^8.18.0",
    "agent-robot-avatar": "^0.5.2",
    "ai": "^7.0.142",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "google-auth-library": "^10.9.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.453.0",
    "mermaid": "12.2.0",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.droidcore.glasspip",
    "productName": "Glass PiP Chat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
