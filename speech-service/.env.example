# ============================================================
# Ally Speech Service — Environment Variables
# Copy this file to .env and fill in your keys.
# ============================================================

# ----------------------------------------------------------
# STT backend: 'deepgram' (streaming, low-latency) or 'whisper' (offline)
# ----------------------------------------------------------
STT_MODE=whisper

# Deepgram API key — required when STT_MODE=deepgram
# Get your key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Whisper model size (used when STT_MODE=whisper)
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# ----------------------------------------------------------
# TTS backend: 'elevenlabs' (streaming, low-latency) or 'coqui' (offline)
# ----------------------------------------------------------
TTS_MODE=coqui

# ElevenLabs keys — required when TTS_MODE=elevenlabs
# Get your key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Voice ID — choose from https://api.elevenlabs.io/v1/voices
# Default: Rachel (21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Coqui TTS model (used when TTS_MODE=coqui or as fallback)
TTS_MODEL=tts_models/en/jenny/jenny

# ----------------------------------------------------------
# WebSocket server
# ----------------------------------------------------------
WEBSOCKET_PORT=8765
