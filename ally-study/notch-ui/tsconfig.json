{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": "../../glass-pip-chat",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "main.tsx",
    "../../glass-pip-chat/src/types/*.d.ts",
    "../../glass-pip-chat/src/vite-env.d.ts"
  ]
}
