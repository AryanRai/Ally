# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Discord Bot Configuration
# Create a Discord app at https://discord.com/developers/applications
# 1. Create app → Bot → copy token
# 2. OAuth2 → copy Client ID (= Application ID)
# 3. General Information → copy Public Key
# 4. Set Interactions Endpoint URL to: https://your-domain.vercel.app/api/discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here

# Local System Configuration
LOCAL_SYSTEM_ID=ally-web-system
LOCAL_SYSTEM_NAME=Ally Web System

# Polling Configuration
POLL_INTERVAL=2000
BATCH_SIZE=10
HEARTBEAT_INTERVAL=30000

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Optional: Custom domain for production
NEXT_PUBLIC_DOMAIN=your-ally-domain.vercel.app

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here