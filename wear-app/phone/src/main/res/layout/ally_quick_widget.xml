<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/widget_panel">
    <ImageView android:id="@+id/widget_orb" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ally_launcher" android:scaleType="fitCenter" android:contentDescription="Talk to Ally"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALLY" android:fontFamily="@font/tanker" android:textSize="23sp" android:textColor="#F4F4F5"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp">
            <TextView android:id="@+id/widget_voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Talk" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="10sp"/>
            <TextView android:id="@+id/widget_agents" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Agents" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="10sp"/>
            <TextView android:id="@+id/widget_inbox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Inbox" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
