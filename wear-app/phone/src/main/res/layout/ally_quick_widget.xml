<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_panel">
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="ALLY" android:fontFamily="@font/tanker" android:textSize="23sp" android:textColor="#F4F4F5"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp">
        <TextView android:id="@+id/widget_voice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/widget_primary" android:text="Talk" android:fontFamily="@font/geist_regular" android:textColor="#0C0C0D" android:textSize="11sp" android:contentDescription="Start Ally voice input"/>
        <TextView android:id="@+id/widget_agents" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:background="@drawable/widget_secondary" android:text="Agents" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="11sp" android:contentDescription="Open agent monitor"/>
        <TextView android:id="@+id/widget_inbox" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:gravity="center" android:background="@drawable/widget_secondary" android:text="Inbox" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
