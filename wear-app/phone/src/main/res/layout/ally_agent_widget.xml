<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_panel">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALLY" android:fontFamily="@font/tanker" android:textSize="25sp" android:textColor="#F4F4F5"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="  /  AGENTS" android:fontFamily="@font/geist_mono" android:textSize="9sp" android:letterSpacing="0.12" android:textColor="#99999E"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="32dp" android:text="↻" android:gravity="center" android:textSize="24sp" android:textColor="#99999E" android:contentDescription="Refresh agent status"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_orb" android:layout_width="76dp" android:layout_height="match_parent" android:maxHeight="96dp" android:src="@drawable/ally_launcher" android:scaleType="fitCenter" android:contentDescription="Talk to Ally"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready when you are" android:fontFamily="@font/geist_regular" android:textSize="20sp" android:textColor="#F4F4F5" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Your conversations at a glance" android:fontFamily="@font/geist_regular" android:textSize="11sp" android:textColor="#99999E" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="6dp">
        <TextView android:id="@+id/widget_chat" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:background="@drawable/widget_secondary" android:fontFamily="@font/geist_regular" android:textSize="11sp" android:textColor="#CCCCD2" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_chat2" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:background="@drawable/widget_secondary" android:fontFamily="@font/geist_regular" android:textSize="11sp" android:textColor="#CCCCD2" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_checked" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap refresh to check" android:fontFamily="@font/geist_mono" android:textSize="8sp" android:textColor="#99999E" android:layout_marginBottom="8dp"/>
    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="40dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageView android:id="@+id/widget_voice_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/widget_voice" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Talk to Ally" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="12sp" android:contentDescription="Start Ally voice input"/>
        </FrameLayout>
        <TextView android:id="@+id/widget_agents" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/widget_secondary" android:gravity="center" android:text="Agent monitor ↗" android:fontFamily="@font/geist_regular" android:textColor="#F4F4F5" android:textSize="12sp" android:contentDescription="Open agent monitor without listening"/>
    </LinearLayout>
</LinearLayout>
