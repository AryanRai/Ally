<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <queries>
        <package android:name="com.google.android.apps.bard" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
    </queries>
    <application android:name=".AllyPhoneApplication" android:label="Ally" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@mipmap/ally_robot_launcher_v3" android:roundIcon="@mipmap/ally_robot_launcher_v3"
        android:allowBackup="false" android:usesCleartextTraffic="false" android:dataExtractionRules="@xml/backup_rules">
        <activity android:name=".WidgetEntryActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="dev.ally.phone.widget" android:theme="@style/AllyWidgetEntry" />
        <receiver android:name=".AllyAgentWidget" android:label="@string/widget_agents_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/><action android:name="dev.ally.phone.SURFACE_CHANGED"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ally_agent_widget"/>
        </receiver>
        <receiver android:name=".AllyQuickWidget" android:label="@string/widget_quick_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ally_quick_widget"/>
        </receiver>
        <service android:name=".AllyQuickTile" android:label="Ally agents" android:icon="@drawable/ic_ally" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name="dev.ally.device.AllyAssistantService" android:label="Ally" android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/ally_assistant" />
        </service>
        <service android:name="dev.ally.device.AllyRecognitionService" android:exported="true" android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <service android:name="dev.ally.device.AllyAssistantSessionService" android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".AllyControlService" android:label="@string/control_service_label" android:exported="false" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/ally_control_service" />
        </service>
        <receiver android:name=".ControlStopReceiver" android:exported="false" />
        <activity android:name=".notch.PhoneNotchSettingsActivity" android:exported="false" />
        <activity android:name=".notch.PhoneNotchActivity" android:exported="false" android:theme="@style/AllyNotchPanel" android:launchMode="singleTop" />
        <service android:name=".notch.PhoneNotchService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled persistent camera-cutout status overlay for agent progress and real decision review" />
        </service>
        <service android:name=".notch.PhoneNotchListener" android:label="Ally notch · selected apps only" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name=".PhysicalTapService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <activity android:name="dev.ally.device.DeviceAccessActivity" android:exported="false" />
        <activity android:name=".PhoneStreamActivity" android:exported="false" />
        <service android:name=".PhoneStreamService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <activity android:name=".PhysicalTapSettingsActivity" android:exported="false" />
        <activity android:name=".MediaHandoffActivity" android:exported="false" />
        <activity android:name=".AcousticSettingsActivity" android:exported="false" />
        <service android:name=".AcousticProbeService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".AllyMediaListener" android:label="Ally now-playing handoff" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <activity android:name=".ControlUnlockActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="dev.ally.phone.unlock" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name="dev.ally.device.DeviceLinkService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name="dev.ally.device.DeviceDecisionReceiver" android:exported="false" />
        <receiver android:name="dev.ally.device.DeviceDismissReceiver" android:exported="false" />
        <activity android:name="dev.ally.device.DeviceInboxActivity" android:exported="false" />
        <activity android:name="dev.ally.device.AssistantUnlockActivity" android:exported="false" android:excludeFromRecents="true" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.attachments" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/attachment_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.ASSIST" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name="dev.ally.device.ShareToChatActivity" android:exported="true" android:launchMode="singleTask" android:label="Share to Ally">
            <intent-filter><action android:name="android.intent.action.SEND" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="*/*" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.SEND_MULTIPLE" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="*/*" /></intent-filter>
        </activity>
    </application>
</manifest>
